<Window x:Class="CodexHp.App.Presentation.Accounts.AccountsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="계정 연동"
        Width="560"
        Height="420"
        MinWidth="480"
        MinHeight="360"
        FontFamily="Segoe UI"
        FontSize="13"
        ThemeMode="System"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        Closing="OnClosing">
    <Window.Resources>
        <Style x:Key="CompactButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="10,2" />
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SurfaceStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="0.5" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="{DynamicResource ControlFillColorTertiaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource FocusStrokeColorOuterBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground"
                                        Value="{DynamicResource TextFillColorDisabledBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PasswordBoxStyle" TargetType="PasswordBox">
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="4,1" />
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SurfaceStrokeColorDefaultBrush}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Margin="0,0,0,10"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Text="계정 연동 — 인증정보는 이 PC에 저장됩니다." />

        <ScrollViewer Grid.Row="1"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Codex -->
                <Border BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}"
                        BorderThickness="0.5"
                        Padding="10"
                        Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" FontWeight="SemiBold" Text="Codex" />
                        <TextBlock x:Name="CodexStatusText"
                                   Grid.Row="0" Grid.Column="1"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="미연결" />
                        <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal">
                            <Button x:Name="CodexConnectButton"
                                    Style="{StaticResource CompactButtonStyle}"
                                    Content="이 PC의 Codex 연결"
                                    Click="OnCodexConnect" />
                            <Button x:Name="CodexDisconnectButton"
                                    Style="{StaticResource CompactButtonStyle}"
                                    Content="연결 해제"
                                    Margin="6,0,0,0"
                                    Click="OnCodexDisconnect" />
                        </StackPanel>
                        <TextBlock x:Name="CodexHintText"
                                   Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                                   Margin="0,6,0,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="기존 로컬 Codex 로그인 파일을 사용합니다." />
                    </Grid>
                </Border>

                <!-- Claude -->
                <Border BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}"
                        BorderThickness="0.5"
                        Padding="10"
                        Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" FontWeight="SemiBold" Text="Claude" />
                        <TextBlock x:Name="ClaudeStatusText"
                                   Grid.Row="0" Grid.Column="1"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="미연결" />
                        <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal">
                            <Button x:Name="ClaudeConnectButton"
                                    Style="{StaticResource CompactButtonStyle}"
                                    Content="세션 등록"
                                    Click="OnClaudeConnect" />
                            <Button x:Name="ClaudeDisconnectButton"
                                    Style="{StaticResource CompactButtonStyle}"
                                    Content="연결 해제"
                                    Margin="6,0,0,0"
                                    Click="OnClaudeDisconnect" />
                        </StackPanel>
                        <PasswordBox x:Name="ClaudePasswordBox"
                                     Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                     Margin="0,6,0,0"
                                     Style="{StaticResource PasswordBoxStyle}"
                                     PasswordChanged="OnClaudePasswordChanged" />
                        <TextBlock x:Name="ClaudeHintText"
                                   Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
                                   Margin="0,6,0,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="claude.ai 세션 쿠키를 붙여넣어 등록합니다. 기술 사용자용 베타입니다." />
                    </Grid>
                </Border>

                <!-- Ollama Cloud -->
                <Border BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}"
                        BorderThickness="0.5"
                        Padding="10"
                        Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" FontWeight="SemiBold" Text="Ollama Cloud" />
                        <TextBlock x:Name="OllamaStatusText"
                                   Grid.Row="0" Grid.Column="1"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="미연결" />
                        <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal">
                            <Button x:Name="OllamaConnectButton"
                                    Style="{StaticResource CompactButtonStyle}"
                                    Content="세션 등록"
                                    Click="OnOllamaConnect" />
                            <Button x:Name="OllamaDisconnectButton"
                                    Style="{StaticResource CompactButtonStyle}"
                                    Content="연결 해제"
                                    Margin="6,0,0,0"
                                    Click="OnOllamaDisconnect" />
                        </StackPanel>
                        <PasswordBox x:Name="OllamaPasswordBox"
                                     Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                     Margin="0,6,0,0"
                                     Style="{StaticResource PasswordBoxStyle}"
                                     PasswordChanged="OnOllamaPasswordChanged" />
                        <TextBlock x:Name="OllamaHintText"
                                   Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
                                   Margin="0,6,0,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="ollama.com 세션 쿠키를 붙여넣어 등록합니다. 기술 사용자용 베타입니다." />
                    </Grid>
                </Border>

                <!-- 고급 -->
                <Border BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}"
                        BorderThickness="0.5"
                        Padding="10">
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" Text="고급" />
                        <Button x:Name="ImportEnvButton"
                                Style="{StaticResource CompactButtonStyle}"
                                Content="기존 환경변수 설정 가져오기"
                                Margin="0,6,0,0"
                                HorizontalAlignment="Left"
                                Click="OnImportEnvironment" />
                        <TextBlock x:Name="ImportResultText"
                                   Margin="0,6,0,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Button x:Name="CloseButton"
                Grid.Row="2"
                Width="92"
                Height="26"
                Margin="0,10,0,0"
                HorizontalAlignment="Right"
                Style="{StaticResource CompactButtonStyle}"
                Content="닫기"
                IsCancel="True"
                Click="OnClose" />
    </Grid>
</Window>
